# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

*.pdb
*.ilk

# Compiled Dynamic libraries - ignore globally except in dependencies
*.dll
!dependencies/**/*.dll

*.so
*.dylib

# Compiled Static libraries - ignore globally except in dependencies
*.a
!dependencies/**/*.a

src/Resources/Models/**

*.lai
*.la
*.lib

# Executables - ignore globally
*.exe
*.out
*.app

# Build directories - ignore, but keep dependencies/bin
/build/

# Generated IDE index (machine-specific absolute paths)
/compile_commands.json

# Dependencies: explicitly keep this folder and everything inside it
!dependencies/
!dependencies/bin/
!dependencies/bin/**
!dependencies/**

# VSCode settings
.vscode/

# UN-IGNORE specific files you need to share (e.g., extensions list)
!.vscode/extensions.json
!.vscode/launch.json
